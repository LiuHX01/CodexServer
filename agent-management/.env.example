# Run: uv run python -m scripts.bootstrap to generate local secrets.
RELAY_DATABASE_URL=postgresql+asyncpg://relay@127.0.0.1:55432/agentrelay
RELAY_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-24-characters
# Keep this stable: signs cookies AND encrypts stored agent credentials.
RELAY_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
RELAY_EMBEDDED_WORKER=true
RELAY_POLL_SECONDS=2
RELAY_RECONCILE_SECONDS=10
RELAY_COOKIE_SECURE=false
# Optional identities; generate separate random tokens for each person.
RELAY_ACCESS_KEYS=[]

# Optional container cloud message worker
# RELAY_CONTAINER_CLOUD_ENDPOINT=wss://.../api/v1/relay-demo/worker
# RELAY_CONTAINER_CLOUD_TOKEN=...
# Optional; defaults to RELAY_ADMIN_TOKEN.
# RELAY_CONTAINER_CLOUD_MANAGEMENT_TOKEN=...
RELAY_CONTAINER_CLOUD_MANAGEMENT_URL=http://127.0.0.1:8080
RELAY_CONTAINER_CLOUD_LOCAL_MODE=false
# RELAY_CONTAINER_CLOUD_EXPECTED_IP=172.25.76.71
