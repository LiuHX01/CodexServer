# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-this-with-a-random-secret-at-least-24-characters

DATA_DIR=./data
CODEX_HOME=./data/codex
WORKSPACE_ROOT=/Users/liuhanxi03/tools/testcode
# Optional existing project directory within WORKSPACE_ROOT (absolute or relative to it).
# DEFAULT_CWD=my-project

# chatgpt: log in with app.codex_cli; ccswitch: import selected third-party provider.
CODEX_AUTH_MODE=chatgpt
CODEX_PROVIDER_CONFIG_DIR=~/.codex
# In ccswitch mode, the selected provider model replaces CODEX_MODEL as the default.
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_APPROVAL_POLICY=never
# JSON arrays. The configured CODEX_MODEL is always allowed.
ALLOWED_MODELS=[]
ALLOWED_APPROVAL_POLICIES=["never","on-request","untrusted"]
# CODEX_BIN=/absolute/path/to/codex

CODEX_SANDBOX=workspace-write
MAX_CONCURRENT_RUNS=4
# Total accepted live runs, including queued and running runs.
MAX_PENDING_RUNS=100
RUN_TIMEOUT_SECONDS=1800
SHUTDOWN_TIMEOUT_SECONDS=15
ENABLE_DOCS=true
