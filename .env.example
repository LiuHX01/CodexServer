# Shared CodexServer configuration.
# Copy this file to .env. Values in the process environment override this file.

# ----- agent-execution -----
API_TOKEN=replace-this-with-a-random-secret-at-least-24-characters
DATA_DIR=./data
CODEX_HOME=./data/codex
WORKSPACE_ROOT=./data/workspaces
# DEFAULT_CWD=project-name

# chatgpt: use Codex ChatGPT login; ccswitch: use ~/.codex/config.toml.
CODEX_AUTH_MODE=ccswitch
CODEX_PROVIDER_CONFIG_DIR=~/.codex
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_APPROVAL_POLICY=never
ALLOWED_MODELS=[]
ALLOWED_APPROVAL_POLICIES=["never","on-request","untrusted"]
# CODEX_BIN=/absolute/path/to/codex
CODEX_SANDBOX=workspace-write
MAX_CONCURRENT_RUNS=4
MAX_PENDING_RUNS=100
RUN_TIMEOUT_SECONDS=1800
SHUTDOWN_TIMEOUT_SECONDS=15
ENABLE_DOCS=true

# ----- agent-management -----
RELAY_DATABASE_URL=postgresql+asyncpg://relay@127.0.0.1:55432/agentrelay
RELAY_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-24-characters
RELAY_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
RELAY_EMBEDDED_WORKER=true
RELAY_POLL_SECONDS=2
RELAY_RECONCILE_SECONDS=10
RELAY_COOKIE_SECURE=false
RELAY_ACCESS_KEYS=[]
RELAY_DATA_DIR=./data

# Optional container-cloud Worker settings.
# RELAY_CONTAINER_CLOUD_ENDPOINT=wss://example.test/api/v1/relay-demo/worker
# RELAY_CONTAINER_CLOUD_TOKEN=container-cloud-pairing-token
# RELAY_CONTAINER_CLOUD_MANAGEMENT_TOKEN=management-api-token
RELAY_CONTAINER_CLOUD_MANAGEMENT_URL=http://127.0.0.1:8080
RELAY_CONTAINER_CLOUD_LOCAL_MODE=false
# RELAY_CONTAINER_CLOUD_PRESET_DIR=/absolute/path/to/project
RELAY_CONTAINER_CLOUD_RESULT_POLL_SECONDS=1
RELAY_CONTAINER_CLOUD_RESULT_TIMEOUT_SECONDS=1800
RELAY_CONTAINER_CLOUD_RECONNECT_INITIAL_SECONDS=1
RELAY_CONTAINER_CLOUD_RECONNECT_MAX_SECONDS=15
RELAY_CONTAINER_CLOUD_CONNECT_TIMEOUT_SECONDS=10
RELAY_CONTAINER_CLOUD_MANAGEMENT_TIMEOUT_SECONDS=30
